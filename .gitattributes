# 默认按文本处理，仓库内统一 LF
* text=auto eol=lf

# .bat 必须是 GBK 字节 + CRLF，否则 cmd 下中文乱码；eol=crlf 保证任何机器检出都是 CRLF
*.bat text eol=crlf

# 程序段导出：内容含 CRLF 分隔的 ST 块，按文本存但要保持行尾一致
*.st.txt text eol=lf

# 依赖与快照按文本比对
*.py text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.txt text eol=lf
*.json text eol=lf

# 二进制底稿（剪贴板原始数据），不要让 git 碰
*.bin binary
*.pdf binary
*.xlsx binary
